{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Switchyard - an OpenAI-compatible failover gateway with a prioritized model list",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "mock": "node test/mock-provider.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "calibrate": "node --env-file-if-exists=.env scripts/calibrate-tokenizer.ts",
    "typecheck": "tsc --noEmit"
  }
}
