# API key for the model provider. The variable name must match
# providers[].apiKeyEnv in config.json (default: DASHSCOPE_API_KEY).
# Common alternatives: SWITCHYARD_API_KEY, OPENAI_API_KEY.
#
# Optional: the gateway starts fine without any key — only the requests
# routed to a provider without a key answer 503 switchyard.no_key.
# With several providers, give each one its own variable and point
# providers[].apiKeyEnv at it.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional runtime overrides
# SWITCHYARD_PORT=8788
# SWITCHYARD_CONFIG=./config.json
# SWITCHYARD_PROVIDER=https://dashscope.aliyuncs.com/compatible-mode/v1
# SWITCHYARD_LOG_LEVEL=info
